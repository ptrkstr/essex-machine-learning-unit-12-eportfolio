source "https://rubygems.org"

# GitHub Pages builds the site with this gem, which pins Jekyll and the
# supported plugins to the versions GitHub Pages runs. Building locally with the
# same gem keeps local previews consistent with the deployed site.
gem "github-pages", group: :jekyll_plugins

# Local preview only: Ruby 3.0 removed webrick from the standard library and
# `jekyll serve` needs it. GitHub Pages ignores this file when building.
gem "webrick"
